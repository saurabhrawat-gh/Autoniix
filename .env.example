# ═══════════════════════════════════════════════════════════════════
#  YT-AUTOMATION — Master Environment Configuration
# ═══════════════════════════════════════════════════════════════════
#
#  QUICK-START CHECKLIST — 6 keys needed to produce your first video:
#
#   1. OPENAI_API_KEY        — platform.openai.com/api-keys         (REQUIRED)
#   2. FISH_AUDIO_API_KEY    — fish.audio                           (REQUIRED)
#   3. YOUTUBE_API_KEY       — console.cloud.google.com             (REQUIRED)
#   4. GOOGLE_OAUTH_*        — console.cloud.google.com (OAuth)     (REQUIRED)
#   5. PIXABAY_API_KEY       — pixabay.com/api/docs                 (REQUIRED)
#   6. PEXELS_API_KEY        — pexels.com/api                       (REQUIRED)
#
#  Copy this file to .env, fill in the values, then: docker compose up -d
#
#  Priority legend:
#    REQUIRED     — pipeline will fail without this
#    RECOMMENDED  — quality/redundancy, strongly advised for production
#    OPTIONAL     — enhances features but not a blocker
# ═══════════════════════════════════════════════════════════════════


# ─── Environment Mode ──────────────────────────────────
# "test"       — uses free/mock providers, skips YouTube upload
# "production" — uses real paid APIs, full pipeline
ENVIRONMENT_MODE=test

# ─── Domain & Gateway ───────────────────────────────────
DOMAIN=localhost
ACME_EMAIL=admin@yourdomain.com


# ═══════════════════════════════════════════════════════════════════
#  INFRASTRUCTURE (self-hosted, set your own secure passwords)
# ═══════════════════════════════════════════════════════════════════

# ─── App Database (PostgreSQL + pgvector) ───────────────
# Used by all 12 microservices. Change passwords before production!
# Generate strong passwords: openssl rand -base64 48
DB_HOST=postgres-app
DB_PORT=5432
DB_NAME=yt_automation
DB_USER=app
DB_PASSWORD=change_me_strong_random_64

# ─── Temporal Database ──────────────────────────────────
# Separate Postgres instance for Temporal workflow engine
TEMPORAL_DB_PASSWORD=change_me_temporal_64

# ─── Redis ──────────────────────────────────────────────
# Caching, BullMQ queues (Remotion), pub/sub
# No password by default in Docker; add AUTH for production
REDIS_URL=redis://redis:6379

# ─── Object Storage (MinIO — S3-compatible) ─────────────
# Stores: voiceover audio, thumbnails, stock assets, rendered videos
# Change minioadmin defaults before production!
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=yt-automation
S3_PUBLIC_BASE_URL=http://localhost:9000/yt-automation
S3_FORCE_PATH_STYLE=true


# ═══════════════════════════════════════════════════════════════════
#  AI / LLM PROVIDERS
# ═══════════════════════════════════════════════════════════════════

# ─── OpenAI [REQUIRED] ─────────────────────────────────
# Powers: GPT-4o (script, thumbnail concepts, QC, direction, hooks,
#         emotion, ideation) + DALL-E 3 (thumbnails) + GPT-4o Vision
# Signup:  https://platform.openai.com/api-keys
# Pricing: GPT-4o — $2.50/1M input, $10/1M output tokens
#          GPT-4o-mini — $0.15/1M input, $0.60/1M output tokens
#          DALL-E 3 HD — $0.08-0.12/image
# Tip:     Add $20 prepaid credit to start; ~$0.50-1.50/video for LLM
OPENAI_API_KEY=sk-your-openai-key

# ─── Anthropic / Claude [RECOMMENDED] ──────────────────
# Powers: Script writing (Claude Sonnet 4 — registered as llm.script)
# Signup:  https://console.anthropic.com
# Pricing: Sonnet 4 — $3/1M input, $15/1M output tokens
#          Haiku 3.5 — $0.80/1M input, $4/1M output tokens
# Why:     Better creative writing than GPT-4o for scripts; also
#          provides LLM redundancy if OpenAI is down
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key

# ─── Google AI / Gemini [RECOMMENDED] ──────────────────
# Powers: Research analysis, QC scoring (registered as llm.research, llm.qc)
# Signup:  https://aistudio.google.com/apikey
# Pricing: Gemini 2.5 Flash — $0.15/1M input, $0.60/1M output (very cheap)
#          Gemini 1.5 Pro — $1.25/1M input, $5/1M output
# Free:    Generous free tier for Gemini Flash
# Why:     20x cheaper than GPT-4o for non-critical research/QC tasks
GOOGLE_AI_API_KEY=your-google-ai-key


# ═══════════════════════════════════════════════════════════════════
#  TEXT-TO-SPEECH (TTS)
# ═══════════════════════════════════════════════════════════════════

# ─── Fish Audio [REQUIRED — default TTS] ───────────────
# Powers: All voiceover generation (default provider)
# Signup:  https://fish.audio
# Pricing: $15 per 1M UTF-8 bytes (PAYG). ~$0.02-0.05/video
# Tip:     Browse fish.audio voice library, copy a voice reference_id,
#          then update your channel config in the DB (or seed-data.sql)
FISH_AUDIO_API_KEY=your-fish-audio-key

# ─── ElevenLabs [OPTIONAL — alternative TTS] ──────────
# Powers: Higher-fidelity voices (swap via TTS_PROVIDER=elevenlabs)
# Signup:  https://elevenlabs.io
# Pricing: Starter $5/mo (30K chars), Creator $22/mo (100K chars)
# Free:    10K chars/month on free plan (enough for ~1 short video)
# Note:    seed-data.sql has REPLACE_VOICE_A placeholder — update with
#          your ElevenLabs voice_id if using this provider
ELEVENLABS_API_KEY=your-elevenlabs-key
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Which TTS provider to use: "fishaudio" or "elevenlabs"
TTS_PROVIDER=fishaudio


# ═══════════════════════════════════════════════════════════════════
#  SEARCH PROVIDERS
# ═══════════════════════════════════════════════════════════════════

# ─── SerpAPI [RECOMMENDED] ─────────────────────────────
# Powers: Google web/video/news search in research pipeline
# Signup:  https://serpapi.com
# Pricing: Basic $50/mo (5,000 searches). ~$0.01/query
# Free:    100 searches/month on free plan
# Why:     Without this, research relies only on YouTube API + Wikipedia
SERPAPI_KEY=your-serpapi-key

# ─── NewsAPI [OPTIONAL] ────────────────────────────────
# Powers: Trending news article search in research pipeline
# Signup:  https://newsapi.org/register
# Pricing: Free (Developer) — 100 req/day, no commercial use
#          Business — $449/mo (unlimited, commercial)
# Tip:     Free tier is sufficient for testing and low-volume production
NEWS_API_KEY=your-newsapi-key

# Which search provider to use: "serpapi"
SEARCH_PROVIDER=serpapi


# ═══════════════════════════════════════════════════════════════════
#  IMAGE & STOCK FOOTAGE
# ═══════════════════════════════════════════════════════════════════

# ─── Pixabay [REQUIRED] ────────────────────────────────
# Powers: Stock video/image search in assets service
# Signup:  https://pixabay.com/api/docs/  (instant, free)
# Pricing: Completely free. 5,000 req/hour
# Note:    Searched in parallel with Pexels; DALL-E is fallback only
PIXABAY_API_KEY=your-pixabay-key

# ─── Pexels [REQUIRED] ─────────────────────────────────
# Powers: Stock video/image search in assets service
# Signup:  https://www.pexels.com/api/  (instant, free)
# Pricing: Completely free. 200 req/hour
PEXELS_API_KEY=your-pexels-key

# ─── Envato Elements [OPTIONAL] ────────────────────────
# Powers: Premium stock footage/music/templates in assets service
# Signup:  https://elements.envato.com
# Pricing: $16.50/mo subscription (unlimited downloads)
# Note:    Searched in parallel with Pixabay/Pexels. Adds premium footage
ENVATO_API_KEY=your-envato-elements-key

# ─── Freesound [OPTIONAL] ──────────────────────────────
# Powers: SFX and ambient audio for the assets service
# Signup:  https://freesound.org/apiv2/apply/  (OAuth2 app registration)
# Pricing: Completely free (attribution required for some sounds)
FREESOUND_API_KEY=your-freesound-key

# Thumbnail/fallback image generation: "dalle" (uses OPENAI_API_KEY)
IMAGE_PROVIDER=dalle


# ═══════════════════════════════════════════════════════════════════
#  STORAGE PROVIDER
# ═══════════════════════════════════════════════════════════════════

# Uses the MinIO credentials above. No additional keys needed.
STORAGE_PROVIDER=minio


# ═══════════════════════════════════════════════════════════════════
#  LLM ROUTING — task-specific model routing
# ═══════════════════════════════════════════════════════════════════
# Each pipeline phase can use a different LLM provider for cost/quality.
# Values: "openai", "gemini", "claude"
# The provider must have its API key set above to work.
#
# Cost-optimized defaults:
#   - Research/QC → Gemini Flash (cheapest, good enough for analysis)
#   - Script → Claude Sonnet (best creative writing)
#   - Everything else → OpenAI GPT-4o (best all-rounder)

LLM_PROVIDER=openai
LLM_RESEARCH_PROVIDER=gemini
LLM_SCRIPT_PROVIDER=claude
LLM_FACTCHECK_PROVIDER=openai
LLM_QC_PROVIDER=gemini
LLM_VISION_PROVIDER=openai
LLM_IDEATION_PROVIDER=openai
LLM_HOOK_PROVIDER=openai
LLM_DIRECTION_PROVIDER=openai
LLM_EMOTION_PROVIDER=openai


# ═══════════════════════════════════════════════════════════════════
#  YOUTUBE — Data API + OAuth Upload
# ═══════════════════════════════════════════════════════════════════

# ─── YouTube Data API [REQUIRED] ───────────────────────
# Powers: Video search (research), trending analysis (analytics),
#         competitor insights, video stats collection
# Signup:  https://console.cloud.google.com
#          → Enable "YouTube Data API v3"
#          → Credentials → Create API Key
# Pricing: Free — 10,000 quota units/day (search=100, video.list=1)
YOUTUBE_API_KEY=your-youtube-api-key

# ─── Google OAuth [REQUIRED for upload] ────────────────
# Powers: YouTube video upload + thumbnail upload via YouTube Data API v3
# Pricing: Free (but requires OAuth consent screen verification for public)
#
# Setup steps:
#   1. Google Cloud Console → APIs & Services → Credentials
#   2. Create OAuth 2.0 Client ID (type: Web Application)
#   3. Add authorized redirect URI: http://localhost:8080
#   4. Copy Client ID and Client Secret below
#   5. Get refresh token using ONE of these methods:
#      a) OAuth Playground: https://developers.google.com/oauthplayground
#         → Settings gear → Use your own credentials → paste Client ID/Secret
#         → Authorize: https://www.googleapis.com/auth/youtube.upload
#         → Exchange authorization code → copy refresh_token
#      b) Or use: scripts/get_oauth_token.py (if available)
#   6. For production (>100 users): submit OAuth consent screen for
#      Google verification (can take days-weeks)
GOOGLE_OAUTH_CLIENT_ID=your-client-id
GOOGLE_OAUTH_CLIENT_SECRET=your-client-secret
GOOGLE_OAUTH_REFRESH_TOKEN=your-refresh-token


# ═══════════════════════════════════════════════════════════════════
#  GOOGLE SHEETS SYNC [OPTIONAL — monitoring dashboard]
# ═══════════════════════════════════════════════════════════════════
# Syncs DB tables (system_config, output_log, api_usage, feedback,
# trends) to a Google Sheet for at-a-glance monitoring.
#
# Setup:
#   1. Google Cloud Console → Enable "Google Sheets API"
#   2. Create a Service Account → download JSON key
#   3. Paste the ENTIRE JSON key contents into GOOGLE_SHEETS_CREDENTIALS_JSON
#      (single line, no newlines)
#   4. Share your Google Sheet with the service account email
#      (e.g. sa-name@project.iam.gserviceaccount.com)
#   5. Copy the spreadsheet ID from the URL:
#      https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
GOOGLE_SHEETS_ID=your-spreadsheet-id
GOOGLE_SHEETS_CREDENTIALS_JSON=


# ═══════════════════════════════════════════════════════════════════
#  ADMIN & SECURITY
# ═══════════════════════════════════════════════════════════════════

# JWT secret for admin dashboard authentication
# Generate: openssl rand -base64 48
ADMIN_JWT_SECRET=change_me_to_64_char_random_string_here_now


# ═══════════════════════════════════════════════════════════════════
#  TEMPORAL (workflow orchestration — self-hosted, no external keys)
# ═══════════════════════════════════════════════════════════════════

TEMPORAL_HOST=temporal:7233
TEMPORAL_NAMESPACE=default


# ═══════════════════════════════════════════════════════════════════
#  REMOTION (video rendering — self-hosted, no external keys)
# ═══════════════════════════════════════════════════════════════════
# Remotion services are built from ../yt-automation-remotion
# They share Redis (BullMQ queue) and MinIO (render output)
# Env vars for Remotion containers are set in docker-compose.yml
# See services/remotion/.env.example for Remotion-specific config
REMOTION_BASE_URL=http://remotion-api:4000


# ═══════════════════════════════════════════════════════════════════
#  MONTHLY COST ESTIMATE (30 videos/month, production-ready)
# ═══════════════════════════════════════════════════════════════════
#
#  OpenAI (GPT-4o + DALL-E 3) .......... $50-100
#  Fish Audio TTS ....................... $2-5
#  Anthropic (Claude, scripts) .......... $10-30
#  Google AI (Gemini, research/QC) ...... $1-5
#  SerpAPI (web search) ................. $50
#  ElevenLabs (if used) ................. $5-22
#  Envato Elements (if used) ............ $16.50
#  YouTube / Pixabay / Pexels ........... FREE
#  Infrastructure (self-hosted) ......... $0
#  ─────────────────────────────────────────────
#  TOTAL ................................ ~$135-230/mo
#
#  Cost-saving tips:
#    - Use Gemini Flash for research/QC (20x cheaper than GPT-4o)
#    - Use DALL-E "standard" quality for testing ($0.04 vs $0.12)
#    - Fish Audio over ElevenLabs (~5x cheaper per character)
#    - Local intelligence modules skip expensive Vision QC when possible
#    - Redis caching already deduplicates trend/competitor API calls

# ── Phase 2: Observability ───────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# ── Phase 2: Cloudflare R2 (final-render mirror) ─────────────
# Optional. When set, scripts/r2_mirror_finals.sh + the daily backup
# push approved renders to R2 (zero egress, $0.015/GB-mo). Leave blank
# to disable.
R2_ENDPOINT=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=

# ── Phase 2: Daily backup destination ────────────────────────
BACKUP_R2_ENDPOINT=
BACKUP_R2_ACCESS_KEY=
BACKUP_R2_SECRET_KEY=
BACKUP_R2_BUCKET=

# ── v2 Revamp: Sentry, Secrets, Auth, Slack ───────────────────
# Sentry (optional). When unset, all SDK calls are no-ops.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.05
RELEASE_SHA=

# Secrets backend for provider credentials.
#   env       — read from process env (default; legacy-compatible)
#   infisical — use the Infisical service (compose profile: secrets)
#   vault     — use HashiCorp Vault (run your own)
SECRETS_BACKEND=env
SECRETS_FALLBACK=env

# Vault (only when SECRETS_BACKEND=vault)
VAULT_ADDR=http://vault:8200
VAULT_TOKEN=
VAULT_KV_MOUNT=kv

# Infisical (only when SECRETS_BACKEND=infisical)
INFISICAL_SITE_URL=http://infisical:8080
INFISICAL_CLIENT_ID=
INFISICAL_CLIENT_SECRET=
INFISICAL_PROJECT_ID=
INFISICAL_ENV=dev
# Used only when starting the Infisical container itself
INFISICAL_ENCRYPTION_KEY=
INFISICAL_AUTH_SECRET=

# v2 auth — JWT signing secret (rotate in production)
AUTH_JWT_SECRET=dev-insecure-change-me

# Slack webhook (used when notification_routes.config has no override)
SLACK_WEBHOOK_URL=
