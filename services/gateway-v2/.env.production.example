# Production environment variables for Gateway v2

NODE_ENV=production
PORT=8080
LOG_LEVEL=info

# Database
DATABASE_URL=postgresql://autoniix:autoniix@postgres:5432/autoniix

# JWT Configuration
JWT_SECRET=your-production-jwt-secret-min-32-chars-change-this
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_EXPIRES_IN=30d

# CORS
CORS_ORIGIN=https://app.autoniix.com

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=60000

# Monitoring (optional)
# SENTRY_DSN=https://your-sentry-dsn
# NEW_RELIC_LICENSE_KEY=your-new-relic-key
