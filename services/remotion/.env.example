# --- Service ---
NODE_ENV=development
API_PORT=4000
LOG_LEVEL=info

# --- Redis (BullMQ) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Render queue ---
RENDER_CONCURRENCY=1
RENDER_TMP_DIR=./tmp

# --- S3 / R2 storage ---
S3_ENDPOINT=              # e.g. https://<account>.r2.cloudflarestorage.com (leave empty for AWS)
S3_REGION=auto
S3_BUCKET=yt-automation-renders
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=       # e.g. https://cdn.example.com  (prepended to object key in callback)
S3_FORCE_PATH_STYLE=true  # true for R2/MinIO, false for AWS S3

# --- Remotion ---
REMOTION_CONCURRENCY=1
REMOTION_CHROMIUM_OPTIONS=
