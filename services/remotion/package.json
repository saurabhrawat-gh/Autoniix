{
  "name": "yt-automation-remotion",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "Remotion renderer service for YT automation pipeline",
  "engines": {
    "node": "20.18.0",
    "npm": "10.8.2"
  },
  "scripts": {
    "studio": "remotion studio",
    "build:remotion": "remotion bundle src/index.ts",
    "api": "tsx watch src/api/server.ts",
    "worker": "tsx watch src/worker/index.ts",
    "start:api": "tsx src/api/server.ts",
    "start:worker": "tsx src/worker/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write .",
    "smoke": "tsx scripts/smoke.ts",
    "smoke:scene-graph": "tsx scripts/scene-graph-smoke.ts",
    "smoke:sharder": "tsx scripts/sharder-smoke.ts",
    "smoke:critic": "tsx scripts/critic-smoke.ts",
    "smoke:repair": "tsx scripts/repair-smoke.ts",
    "smoke:director-editor": "tsx scripts/director-editor-smoke.ts",
    "smoke:mcp": "tsx scripts/mcp-smoke.ts",
    "mcp": "tsx src/mcp/server.ts",
    "mcp:dev": "tsx watch src/mcp/server.ts",
    "bundle:warmup": "tsx scripts/bundle-warmup.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.645.0",
    "@remotion/bundler": "^4.0.200",
    "@remotion/cli": "^4.0.200",
    "@remotion/google-fonts": "^4.0.200",
    "@remotion/media-utils": "^4.0.200",
    "@remotion/renderer": "^4.0.200",
    "@remotion/transitions": "^4.0.200",
    "bullmq": "^5.12.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "ioredis": "^5.4.1",
    "nanoid": "^5.0.7",
    "pino": "^9.3.2",
    "pino-http": "^10.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.200",
    "undici": "^6.19.8",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.3.3",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  },
  "packageManager": "npm@10.8.2"
}
