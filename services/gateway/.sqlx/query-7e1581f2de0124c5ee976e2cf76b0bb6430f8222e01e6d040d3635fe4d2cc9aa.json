{
  "db_name": "PostgreSQL",
  "query": "SELECT a.id, a.actor_label, a.action, a.target_type, a.target_id,\n                      a.before, a.after, a.created_at\n                 FROM audit_log_v2 a\n                WHERE a.action LIKE 'provider.%'\n                  AND a.target_type = 'provider_credential'\n                  AND a.target_id = $1\n                ORDER BY a.created_at DESC LIMIT $2",
