# Caddyfile — Autoniix reverse proxy + auto-HTTPS
#
# Caddy runs as a host systemd service (NOT in docker), terminating TLS
# on 80/443 and proxying to the docker containers' published ports on
# localhost. Replaces Traefik (see git history for why).
#
# Deploy: copy this file to /etc/caddy/Caddyfile on the VPS, then:
#   sudo systemctl reload caddy
#
# Auto-HTTPS: Caddy provisions Let's Encrypt certs automatically the first
# time each domain is hit. No ACME config required.
#
# Admin UI auth (Prometheus, Alertmanager, Temporal):
#   Set CADDY_ADMIN_USER and CADDY_ADMIN_PASS_HASH in /etc/caddy/caddy.env
#   (loaded via EnvironmentFile= in the caddy systemd unit).
#   Generate hash: caddy hash-password --plaintext 'your-password'

{
    email admin@autoniix.com
}

# Security headers applied to every site.
(secure_headers) {
    header {
        Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        -Server
    }
}

# Basic-auth guard for internal admin UIs.
# Credentials come from environment variables — not stored in this file.
(admin_auth) {
    basic_auth {
        {$CADDY_ADMIN_USER} {$CADDY_ADMIN_PASS_HASH}
    }
}

# Dashboard UI
dash.autoniix.com {
    reverse_proxy localhost:3000
    encode gzip zstd
    import secure_headers
}

# Dashboard API (BFF)
api.autoniix.com {
    reverse_proxy localhost:8020
    encode gzip zstd
    import secure_headers
}

# Grafana (has its own auth — no double-prompt)
grafana.autoniix.com {
    reverse_proxy localhost:3001
    encode gzip zstd
    import secure_headers
}

# Prometheus — protected behind basic auth
prometheus.autoniix.com {
    import admin_auth
    reverse_proxy localhost:9090
    encode gzip zstd
    import secure_headers
}

# Alertmanager — protected behind basic auth
alerts.autoniix.com {
    import admin_auth
    reverse_proxy localhost:9093
    encode gzip zstd
    import secure_headers
}

# Temporal UI — protected behind basic auth
temporal.autoniix.com {
    import admin_auth
    reverse_proxy localhost:8080
    encode gzip zstd
    import secure_headers
}

# Marketing landing page — apex + www
autoniix.com, www.autoniix.com {
    reverse_proxy localhost:3002
    encode gzip zstd
    import secure_headers
}
