{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 0,
  "schemaVersion": 39,
  "tags": ["yt-automation", "pipeline"],
  "time": { "from": "now-1h", "to": "now" },
  "title": "Pipeline Overview",
  "uid": "yt-pipeline-overview",
  "version": 1,
  "panels": [
    {
      "type": "stat",
      "title": "Render success rate (5m)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.8 },
              { "color": "green", "value": 0.95 }
            ]
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(render_outcomes_total{outcome=\"qc_pass\"}[5m])) / clamp_min(sum(rate(render_outcomes_total[5m])), 1)"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Black-frame rejections (1h)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        }
      },
      "targets": [{ "refId": "A", "expr": "sum(increase(render_outcomes_total{outcome=\"qc_fail\"}[1h]))" }]
    },
    {
      "type": "stat",
      "title": "Quality gate blocks (1h)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 0 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{ "refId": "A", "expr": "sum(increase(quality_gate_blocks_total[1h]))" }]
    },
    {
      "type": "stat",
      "title": "LLM cost USD (24h)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 0 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "unit": "currencyUSD" } },
      "targets": [{ "refId": "A", "expr": "sum(increase(llm_cost_usd_total[24h]))" }]
    },
    {
      "type": "timeseries",
      "title": "Pipeline phases (per second)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 6 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (phase, status) (rate(pipeline_phase_total[5m]))",
          "legendFormat": "{{phase}} / {{status}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "HTTP request latency p95 (per service)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 6 },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, job) (rate(http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "{{job}}"
        }
      ]
    },
    {
      "type": "logs",
      "title": "Recent ERROR / WARN logs",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 15 },
      "options": { "showTime": true, "wrapLogMessage": true, "dedupStrategy": "none" },
      "targets": [
        {
          "refId": "A",
          "expr": "{project=\"yt-automation\"} |~ \"(?i)error|warn|fail|qc_fail\""
        }
      ]
    }
  ]
}
