# ═══════════════════════════════════════════════════════════════════
#  AUTONIIX — PRODUCTION environment template
#
#  Copy to .env on the VPS and fill in EVERY value marked CHANGE_ME.
#  The dashboard BFF refuses to start if any *_SECRET / *_PASSWORD is
#  still set to its default placeholder (see main.py startup check).
#
#  Generate secrets with:
#    openssl rand -base64 48                  # JWT / password secrets
#    htpasswd -nbB admin '<password>'         # basic-auth (then double $ signs)
#    python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ═══════════════════════════════════════════════════════════════════

# ─── Mode ───────────────────────────────────────────────
ENVIRONMENT_MODE=production

# ─── Domain layout (split-host) ─────────────────────────
# DNS A-records for each of these must point to this VPS before TLS-up.
DOMAIN=autoniix.com
DASH_DOMAIN=dash.autoniix.com
API_DOMAIN=api.autoniix.com
GRAFANA_DOMAIN=grafana.autoniix.com
PROMETHEUS_DOMAIN=prometheus.autoniix.com
ALERTS_DOMAIN=alerts.autoniix.com
TEMPORAL_DOMAIN=temporal.autoniix.com
ACME_EMAIL=admin@autoniix.com

# ─── CORS allowlist (Dashboard BFF) ─────────────────────
# Must include the dashboard URL exactly; wildcards are rejected.
ALLOWED_ORIGINS=https://dash.autoniix.com

# ─── Traefik basic-auth for admin surfaces ──────────────
# Generate: htpasswd -nbB admin '<strong-password>'
# Paste the raw output verbatim — DO NOT double the $ signs; compose
# handles escaping automatically when sourced from .env.
# Example:  TRAEFIK_BASIC_AUTH=admin:$2y$05$abcdEFG...
TRAEFIK_BASIC_AUTH=CHANGE_ME_user:CHANGE_ME_bcrypt_hash

# ═══════════════════════════════════════════════════════════════════
#  INFRASTRUCTURE (self-hosted)
# ═══════════════════════════════════════════════════════════════════

DB_HOST=postgres-app
DB_PORT=5432
DB_NAME=autoniix
DB_USER=app
DB_PASSWORD=CHANGE_ME_openssl_rand_base64_48

TEMPORAL_DB_PASSWORD=CHANGE_ME_openssl_rand_base64_48

REDIS_URL=redis://redis:6379

S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=CHANGE_ME_minio_root_user
S3_SECRET_KEY=CHANGE_ME_minio_root_password
S3_BUCKET=autoniix
# Public read URL — used in metadata / Remotion / dashboard previews.
# Recommended: serve through Traefik or behind the dashboard, not MinIO direct.
S3_PUBLIC_BASE_URL=https://api.autoniix.com/assets
S3_FORCE_PATH_STYLE=true

# ═══════════════════════════════════════════════════════════════════
#  AI / LLM PROVIDERS  (fill the ones you actually use)
# ═══════════════════════════════════════════════════════════════════

OPENAI_API_KEY=sk-
ANTHROPIC_API_KEY=sk-ant-
GOOGLE_AI_API_KEY=

# TTS
FISH_AUDIO_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
TTS_PROVIDER=fishaudio

# Search
SERPAPI_KEY=
NEWS_API_KEY=
SEARCH_PROVIDER=serpapi

# Stock
PIXABAY_API_KEY=
PEXELS_API_KEY=
FREESOUND_API_KEY=
IMAGE_PROVIDER=dalle
STORAGE_PROVIDER=minio

# LLM routing (defaults are cost-optimized)
LLM_PROVIDER=openai
LLM_RESEARCH_PROVIDER=gemini
LLM_SCRIPT_PROVIDER=claude
LLM_FACTCHECK_PROVIDER=openai
LLM_QC_PROVIDER=gemini
LLM_VISION_PROVIDER=openai
LLM_IDEATION_PROVIDER=openai
LLM_HOOK_PROVIDER=openai
LLM_DIRECTION_PROVIDER=openai
LLM_EMOTION_PROVIDER=openai
LLM_OPENAI_MODEL=gpt-4o-mini
LLM_CLAUDE_MODEL=claude-sonnet-4-20250514
LLM_GEMINI_MODEL=gemini-2.5-flash

# ═══════════════════════════════════════════════════════════════════
#  YOUTUBE
# ═══════════════════════════════════════════════════════════════════
YOUTUBE_API_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# ─── Optional Google Sheets monitoring ──────────────────
GOOGLE_SHEETS_ID=
GOOGLE_SHEETS_CREDENTIALS_JSON=

# ═══════════════════════════════════════════════════════════════════
#  ADMIN + SECURITY (REQUIRED — all of these must change)
# ═══════════════════════════════════════════════════════════════════
ADMIN_JWT_SECRET=CHANGE_ME_openssl_rand_base64_48
AUTH_JWT_SECRET=CHANGE_ME_openssl_rand_base64_48
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_openssl_rand_base64_24

# Secrets backend for provider creds (db = Fernet-encrypted in postgres).
SECRETS_BACKEND=db
SECRETS_FALLBACK=env
SECRETS_ENCRYPTION_KEY=CHANGE_ME_python_fernet_generate_key

# Vault / Infisical only if you switch SECRETS_BACKEND.
VAULT_ADDR=http://vault:8200
VAULT_TOKEN=
VAULT_KV_MOUNT=kv
INFISICAL_SITE_URL=http://infisical:8080
INFISICAL_CLIENT_ID=
INFISICAL_CLIENT_SECRET=
INFISICAL_PROJECT_ID=
INFISICAL_ENV=prod
INFISICAL_ENCRYPTION_KEY=
INFISICAL_AUTH_SECRET=

# ═══════════════════════════════════════════════════════════════════
#  TEMPORAL + REMOTION (self-hosted, no external keys)
# ═══════════════════════════════════════════════════════════════════
TEMPORAL_HOST=temporal:7233
TEMPORAL_NAMESPACE=default
REMOTION_BASE_URL=http://remotion-api:4000

# ═══════════════════════════════════════════════════════════════════
#  OBSERVABILITY
# ═══════════════════════════════════════════════════════════════════

# Slack incoming webhook — Alertmanager + notification_routes.
# Create at: https://api.slack.com/messaging/webhooks
# Channels referenced in observability/alertmanager.yml:
#   #yt-alerts  +  #yt-alerts-critical
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/CHANGE/ME/NOW

# ─── Transactional Email (SMTP) — password reset, invites, etc. ───
# Must be set in production. Defaults below are for Gmail (free, 500/day).
# Switch to SendGrid / SES / Mailgun / Hostinger by changing SMTP_HOST + creds — no code change.
#
# Gmail setup (one-time):
#   1. Enable 2-Step Verification: https://myaccount.google.com/security
#   2. Create an App Password:     https://myaccount.google.com/apppasswords
#   3. Use the 16-char App Password as SMTP_PASSWORD (NOT your regular Gmail password)
#   4. SMTP_FROM must equal SMTP_USER (Gmail rewrites/rejects other From: headers
#      unless you set up "Send mail as" with a verified domain).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASSWORD=CHANGE_ME_16_CHAR_APP_PASSWORD
SMTP_FROM=Autoniix <your-gmail-address@gmail.com>
SMTP_TLS=starttls
SMTP_TIMEOUT_S=10
MAIL_SUBJECT_PREFIX=

# Sentry — every FastAPI service + worker calls init_sentry() at boot.
# Empty value = Sentry disabled (graceful no-op).
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.05
RELEASE_SHA=

# ═══════════════════════════════════════════════════════════════════
#  BACKUPS
# ═══════════════════════════════════════════════════════════════════
# scripts/backup.sh writes daily snapshots here (Postgres dump + MinIO mirror).
# vps_bootstrap.sh creates /mnt/backups owned by the deploy user.
BACKUP_LOCAL_DIR=/mnt/backups
BACKUP_RETENTION_DAYS=14

# Optional offsite mirror (leave empty to skip — local snapshots still land
# in BACKUP_LOCAL_DIR). Works with any S3-compatible target (Hostinger object
# storage, Backblaze B2, Cloudflare R2, AWS S3).
BACKUP_S3_ENDPOINT=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=auto

# Legacy R2-specific vars are still honored by the old script paths.
R2_ENDPOINT=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=
