# act secrets template — copy this file to .act-secrets.local and fill in values
# .act-secrets.local is gitignored — never commit it
#
# How to set up:
#   cp .act-secrets.local.example .act-secrets.local
#   # then edit .act-secrets.local with your real values

# Required: GitHub token (for buf setup action and other actions that call GitHub API)
# Get one at: https://github.com/settings/tokens (needs: read:packages)
GITHUB_TOKEN=your_github_pat_here

# Optional: Chromatic visual regression token
# Get from: https://www.chromatic.com/manage (project settings)
# Leave blank to skip Chromatic step
CHROMATIC_PROJECT_TOKEN=

# Optional: VPS deploy secrets (only needed when testing build.yml deploy job)
VPS_HOST=
VPS_USER=
VPS_SSH_KEY=
