# SINGLE SOURCE OF TRUTH for every toolchain version. Read by verify-versions.sh,
# verify-versions-in-sync.sh, ci-local.sh, ci-local.Dockerfile, and the
# versions-in-sync CI job. Bumping ANY value here fails CI until every
# downstream file is updated to match.

NODE_VERSION=22.23.1
NPM_VERSION=10.9.8
PYTHON_VERSION=3.12.7

DEBIAN_IMAGE=debian:bookworm-slim
NODE_IMAGE=node:22.23.1-bookworm-slim
NODE_ALPINE_IMAGE=node:22.23.1-alpine
PYTHON_IMAGE=python:3.12.7-slim
POSTGRES_IMAGE=pgvector/pgvector:pg15

POSTGRES_CLIENT_MAJOR=15
