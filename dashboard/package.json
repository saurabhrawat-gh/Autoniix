{
  "name": "yt-automation-dashboard",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:tokens": "node scripts/check-ui-tokens.mjs",
    "lint:tokens:strict": "node scripts/check-ui-tokens.mjs --strict",
