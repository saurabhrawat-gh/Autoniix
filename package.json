{
  "name": "autoniix-monorepo",
  "private": true,
  "version": "1.0.0",
  "description": "Autoniix monorepo (Python + TypeScript, Phase 7)",
  "scripts": {
    "prepare": "husky || true",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "clean": "turbo run clean && rm -rf gen node_modules"
  },
  "overrides": {
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7"
  },
  "devDependencies": {
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "turbo": "^2.0.0"
  },
  "workspaces": [
    "frontend/dashboard",
    "frontend/marketing",
    "shared/ts/*",
    "backend/api/gateway",
    "backend/api/streaming-hub"
  ],
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": "22.23.1",
    "npm": "10.9.8"
  }
}
