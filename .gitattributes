# Enforce LF line endings so CI (Linux) and local (macOS/Windows) generate
# byte-identical files. Prevents CRLF-in-Dockerfile bugs and Python shebang
# corruption on Windows checkouts.
* text=auto eol=lf

*.sh   text eol=lf
*.py   text eol=lf
*.sql  text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.rs   text eol=lf
*.go   text eol=lf
*.ts   text eol=lf
*.tsx  text eol=lf
*.js   text eol=lf
*.jsx  text eol=lf
*.json text eol=lf
*.md   text eol=lf
Dockerfile         text eol=lf
Dockerfile.*       text eol=lf
*.Dockerfile       text eol=lf
Makefile           text eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.mp4 binary
*.mp3 binary
*.wav binary
