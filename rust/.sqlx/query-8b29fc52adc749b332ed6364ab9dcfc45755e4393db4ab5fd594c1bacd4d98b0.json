  "query": "SELECT s.id, s.channel_id, s.name, s.description, s.format,\n                  s.target_duration_s, s.cadence, s.thumbnail_style\n             FROM series s\n             JOIN channels c ON c.channel_id = s.channel_id\n            WHERE c.workspace_id = $1\n            ORDER BY s.id",
