  "query": "SELECT wm.user_id, wm.role, wm.joined_at,\n                  u.email, u.display_name\n             FROM workspace_members wm\n             JOIN users u ON u.id = wm.user_id\n            WHERE wm.workspace_id = $1\n            ORDER BY wm.joined_at",
