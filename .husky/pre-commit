#!/usr/bin/env bash
# pre-commit: fast gate (<15s) — catches 90% of CI failures before commit
# Phase 7: Two-language stack (Python + TypeScript only)
set -euo pipefail
ROOT="$(git rev-parse --show-toplevel)"

echo "▶  pre-commit: ruff format check..."
STAGED_PY=$(git diff --cached --name-only 2>/dev/null | grep '\.py$' || true)
if [ -n "$STAGED_PY" ]; then
    if command -v uv >/dev/null 2>&1; then
        uv run ruff format --check $STAGED_PY 2>&1 || {
            echo ""
            echo "❌  Python formatting diff detected."
            echo "    Fix: uv run ruff format ."
            exit 1
        }
        echo "✓  ruff format clean"
    else
        echo "⏭  uv not found — skipping ruff format"
    fi
else
    echo "✓  No .py files staged"
fi

echo "▶  pre-commit: ruff lint check..."
if [ -n "$STAGED_PY" ]; then
    if command -v uv >/dev/null 2>&1; then
        uv run ruff check $STAGED_PY 2>&1 || {
            echo ""
            echo "❌  Ruff lint errors detected."
            echo "    Fix: uv run ruff check --fix ."
            exit 1
        }
        echo "✓  ruff lint clean"
    else
        echo "⏭  uv not found — skipping ruff lint"
    fi
fi

echo "▶  pre-commit: tsc (gateway-v2)..."
if [ -d "$ROOT/services/gateway-v2" ] && command -v npm >/dev/null 2>&1; then
    (cd "$ROOT/services/gateway-v2" && npm run typecheck 2>&1) || {
        echo "❌  TypeScript errors in gateway-v2"
        exit 1
    }
    echo "✓  gateway-v2 tsc clean"
else
    echo "⏭  gateway-v2 not found — skipping tsc"
fi

echo "▶  pre-commit: tsc (streaming-hub-v2)..."
if [ -d "$ROOT/services/streaming-hub-v2" ] && command -v npm >/dev/null 2>&1; then
    (cd "$ROOT/services/streaming-hub-v2" && npm run typecheck 2>&1) || {
        echo "❌  TypeScript errors in streaming-hub-v2"
        exit 1
    }
    echo "✓  streaming-hub-v2 tsc clean"
else
    echo "⏭  streaming-hub-v2 not found — skipping tsc"
fi

echo "▶  pre-commit: tsc (contracts)..."
if [ -d "$ROOT/libs/ts/contracts" ] && command -v npm >/dev/null 2>&1; then
    (cd "$ROOT/libs/ts/contracts" && npm run typecheck 2>&1) || {
        echo "❌  TypeScript errors in contracts"
        exit 1
    }
    echo "✓  contracts tsc clean"
else
    echo "⏭  contracts not found — skipping tsc"
fi

echo ""
echo "✅  pre-commit passed"
