#!/usr/bin/env bash
# pre-commit: fast gate (<15s) — catches 90% of CI failures before commit
set -euo pipefail
ROOT="$(git rev-parse --show-toplevel)"

echo "▶  pre-commit: sqlx query cache check..."
STAGED_RS=$(git diff --cached --name-only 2>/dev/null | grep '\.rs$' || true)
if [ -n "$STAGED_RS" ]; then
    NEW_SQLX=$(git diff --cached -- $STAGED_RS 2>/dev/null | grep '^+.*sqlx::query' | grep -v '^+++' || true)
    if [ -n "$NEW_SQLX" ]; then
        SQLX_STAGED=$(git diff --cached --name-only 2>/dev/null | grep '\.sqlx/' || true)
        if [ -z "$SQLX_STAGED" ]; then
            echo "  🔍 New sqlx query detected — auto-running sqlx-prepare..."
            bash "$ROOT/scripts/sqlx-prepare.sh" || {
                echo "❌  sqlx-prepare failed. Fix the errors and try again."
                exit 1
            }
            git add "$ROOT/.sqlx/"
            echo "✓  .sqlx/ cache updated and staged automatically"
        else
            echo "✓  sqlx cache already staged"
        fi
    else
        echo "✓  No new sqlx queries"
    fi
else
    echo "✓  No .rs files staged"
fi

echo "▶  pre-commit: cargo fmt check..."
if command -v cargo >/dev/null 2>&1; then
    (cd "$ROOT/rust" && cargo fmt --all -- --check 2>&1) || {
        echo ""
        echo "❌  Rust formatting diff detected."
        echo "    Fix: cd rust && cargo fmt --all"
        exit 1
    }
    echo "✓  cargo fmt clean"
else
    echo "⏭  cargo not found — skipping fmt check"
fi

echo "▶  pre-commit: go vet..."
if command -v go >/dev/null 2>&1; then
    (cd "$ROOT/go" && go vet ./... 2>&1) || {
        echo "❌  go vet failed"
        exit 1
    }
    echo "✓  go vet clean"
else
    echo "⏭  go not found — skipping go vet"
fi

echo "▶  pre-commit: tsc (dashboard)..."
if [ -d "$ROOT/apps/dashboard/node_modules" ] && command -v npx >/dev/null 2>&1; then
    (cd "$ROOT/dashboard" && npx tsc --noEmit 2>&1) || {
        echo "❌  TypeScript errors in dashboard"
        exit 1
    }
    echo "✓  dashboard tsc clean"
else
    echo "⏭  apps/dashboard/node_modules missing — skipping tsc"
fi

echo "▶  pre-commit: tsc (remotion)..."
if [ -d "$ROOT/services/remotion/node_modules" ] && command -v npx >/dev/null 2>&1; then
    (cd "$ROOT/services/remotion" && npx tsc --noEmit 2>&1) || {
        echo "❌  TypeScript errors in remotion"
        exit 1
    }
    echo "✓  remotion tsc clean"
else
    echo "⏭  services/remotion/node_modules missing — skipping tsc"
fi

echo "▶  pre-commit: lint-staged (dashboard)..."
cd "$ROOT/dashboard" && npx lint-staged
echo "✓  lint-staged clean"

echo ""
echo "✅  pre-commit passed"
